    "express": "^4.18.0",
    "node-cron": "^3.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "puppeteer": "^22.0.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
