# ─── Frontend (Vite / React) ───────────────────────────
# These are public — safe to embed in the browser bundle.
# Prefix MUST be VITE_ for Vite to expose them to the frontend.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Backend (Express server) ──────────────────────────
# These are SECRET — never expose them in the frontend.

# Supabase service role key (bypasses RLS — backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# WhatsApp (set to "true" only on Render Standard plan — needs 2GB RAM for Chromium)
ENABLE_WHATSAPP=false

# Frontend URL — used by backend for CORS + message links
# Development:
CLIENT_URL=http://localhost:5173
# Production (set to your Vercel URL):
# CLIENT_URL=https://membba.vercel.app

# Server port (Render sets this automatically — leave as 3001 for local dev)
PORT=3001
