# ─── Frontend (Vite / React) ───────────────────────────
# These are public — safe to embed in the browser bundle.
# Prefix MUST be VITE_ for Vite to expose them to the frontend.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key-here

# Optional.
# Leave empty locally to use the Vite /api proxy in vite.config.js.
# Set in production only if the frontend should call the backend directly.
# Example: VITE_API_URL=https://membba-server.onrender.com
VITE_API_URL=

# ─── Backend (Express server) ──────────────────────────
# These are SECRET — never expose them in the frontend.

# Supabase service role key (bypasses RLS — backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# AI / Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# WhatsApp (set to "true" only on Render Standard plan — needs 2GB RAM for Chromium)
ENABLE_WHATSAPP=false

# Optional WhatsApp number that receives AI escalation/admin alerts.
# Example: 2348012345678@s.whatsapp.net
ADMIN_JID=

# Frontend URL — used by backend for CORS + message links
# Development:
CLIENT_URL=http://localhost:5173
# Production (set to your Vercel URL):
# CLIENT_URL=https://membba.vercel.app

# Public backend URL — set this in production so Telegram can use webhooks.
# Example: SERVER_URL=https://membba-server.onrender.com
SERVER_URL=

# Server port (Render sets this automatically — leave as 3001 for local dev)
PORT=3001

# Membba internal operations admins (comma-separated emails)
# Example: founder@membba.com,support@membba.com
MEMBBA_ADMIN_EMAILS=

# WhatsApp provider mode
# baileys = device-linked WhatsApp Web automation
# meta = official Meta WhatsApp Cloud API messaging
# hybrid = use Meta for reliable DMs, Baileys for advanced group automation when connected
WHATSAPP_PROVIDER=baileys
META_GRAPH_VERSION=v20.0
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
