# Production environment variables used by Vite when building for Vercel.
# This file contains only public frontend values — no secrets.
#
# If VITE_API_URL is set, browser API calls go directly to that backend.
# If left empty, browser API calls use same-origin /api/* and rely on vercel.json rewrites.
VITE_API_URL=https://membba-server.onrender.com
